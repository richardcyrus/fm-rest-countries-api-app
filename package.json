{
  "name": "rest-countries-api-app",
  "version": "2.0.0",
  "description": "This is a solution to the REST Countries API with color theme switcher challenge on Frontend Mentor",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "dev:live": "op run --env-file=.env.op -- vp dev",
    "build": "tsc -b && vp build",
    "preview": "vp preview",
    "format": "vp fmt .",
    "lint": "vp lint \"**/*.[jt]s?(x)\"",
    "fix": "vp lint --fix \"**/*.[jt]s?(x)\"",
    "test": "vp test run",
    "test:watch": "vp test watch",
    "test:coverage": "vp test run --coverage",
    "e2e": "pnpm build && playwright test",
    "fixtures:refresh": "op run --env-file=.env.op -- node scripts/refresh-fixtures.ts",
    "test:live": "op run --env-file=.env.op -- env LIVE_API=1 vp test run test/live-contract.test.ts",
    "prepare": "vp config"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/richardcyrus/fm-rest-countries-api-app.git"
  },
  "keywords": [
    "css-custom-properties",
    "frontend-mentor",
    "heroicons-react",
    "html5",
    "reactjs",
    "vite"
  ],
  "author": "Richard Cyrus <richard.cyrus@rcyrus.com> (https://www.richardcyrus.com)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/richardcyrus/fm-rest-countries-api-app/issues"
  },
  "homepage": "https://github.com/richardcyrus/fm-rest-countries-api-app#readme",
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-query-devtools": "^5.104.5",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.4",
    "nitro": "3.0.260903-beta",
    "radix-ui": "^1.8.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tanstack/eslint-plugin-query": "^5.104.5",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "globals": "^16.5.0",
    "happy-dom": "^20.14.6",
    "typescript": "^5.9.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "24.x"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  }
}
